# CityFlow AI Backend Environment Variables
# Copy this file to backend/.env and replace with your actual values

# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Secret / Service Role Key (Backend ONLY - DO NOT expose to frontend or git)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Supabase Publishable / Anon Key
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# API Server Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Groq LLM API Key (Backend ONLY - DO NOT expose to frontend or git)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# TomTom Traffic API Key (Backend ONLY)
TOMTOM_API_KEY=your_tomtom_api_key_here

# Google Maps / Routes API Key (Backend ONLY)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

